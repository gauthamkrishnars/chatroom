rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection rules
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.name != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.createdBy.uid == request.auth.uid);

      // Subcollection messages rules
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string 
                      && request.resource.data.text.size() > 0 
                      && request.resource.data.text.size() <= 1000;
        allow update: if request.auth != null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }
  }
}
